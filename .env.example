# Copy to .env.local and fill in the values.

# --- Contact form (src/actions/send-contact-message.ts) ---

# Resend API key (resend.com > API Keys > "Sending access" key)
CONTACT_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Club inbox that receives each submission
CONTACT_TO_EMAIL=microclub.contact@usthb.edu.dz

# Sender, must be on the domain verified in Resend (microclub.info)
CONTACT_FROM_EMAIL="Micro Club <contact@microclub.info>"

# --- MicroBot (src/actions/ask-microbot.ts, src/lib/microbot-api.ts) ---

# Chat API key of the Micro Bot API (its API_KEY). Server-only: never prefix it with NEXT_PUBLIC_
MICROBOT_API_KEY=

# Optional: API base URL, defaults to the deployed https://micro-bot.microclub.info
# MICROBOT_API_URL=http://localhost:8000

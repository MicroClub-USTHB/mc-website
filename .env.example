# --- Contact form (see README / src/actions/send-contact-message.ts) ---

# Resend API key (resend.com > API Keys > "Sending access" key)
CONTACT_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Club inbox that receives each submission
CONTACT_TO_EMAIL=contact@microclub.info

# Sender, must be on the domain verified in Resend
CONTACT_FROM_EMAIL="MicroClub <contact@microclub.info>"

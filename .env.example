# Copy to .env.local and fill in the values.

# --- Email (src/lib/email.ts): contact form and admin accounts ---

# Resend API key (resend.com > API Keys > "Sending access" key). Server-only.
# Without it, development prints every email to the server console instead of sending it.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Contact form (src/actions/send-contact-message.ts) ---

# Club inbox that receives each submission
CONTACT_TO_EMAIL=microclub.contact@usthb.edu.dz

# Sender, must be on the domain verified in Resend (microclub.info)
CONTACT_FROM_EMAIL="Micro Club <contact@microclub.info>"

# --- Micro Bot (src/actions/ask-microbot.ts, src/lib/microbot-api.ts) ---

# Chat API key of the Micro Bot API (its API_KEY). Server-only: never prefix it with NEXT_PUBLIC_
MICROBOT_API_KEY=

# Optional: API base URL, defaults to the deployed https://micro-bot.microclub.info
# MICROBOT_API_URL=http://localhost:8000

# --- Registrations (src/actions/submit-registration.ts) ---

# MongoDB connection string, also used by the admin accounts (Better Auth). It must be a replica
# set (Atlas is): Better Auth writes in transactions. Local: `pnpm db:up` starts one.
MONGODB_URI=mongodb://localhost:27017/microclub?replicaSet=rs0

# Cloudinary (cloudinary.com > Console > Settings > API Keys): stores the uploaded student IDs.
# API secret is server-only: never prefix any of these with NEXT_PUBLIC_
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin accounts (src/lib/auth/auth.ts, Better Auth) ---

# Signs sessions and tokens: a random value of 32+ characters, e.g. `openssl rand -base64 32`.
# Server-only, different for each environment.
BETTER_AUTH_SECRET=

# Origin of the site, used in auth links and emails. Production: https://www.microclub.info
BETTER_AUTH_URL=http://localhost:3000

# Sender of the admin account emails (credentials, password reset), on the domain verified in Resend
AUTH_FROM_EMAIL="Micro Club <no-reply@microclub.info>"

{
  "name": "mc-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d mongodb",
    "db:down": "docker compose down",
    "db:seed-registrations": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed-registrations.ts",
    "db:recompute-statuses": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/recompute-statuses.ts",
    "db:seed-staff": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed-staff.ts",
    "auth:create-president": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/create-president.ts",
    "auth:deactivate-president": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/deactivate-president.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/mongo-adapter": "^1.7.18",
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^7.0.5",
    "@tanstack/react-table": "^9.3.1",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.70.0",
    "mongodb": "^7.8.0",
    "mongoose": "^9.12.0",
    "motion": "^14.10.1",
    "next": "16.4.2",
    "nodemailer": "^10.5.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.91.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  }
}
